# Copia este archivo a ".env" y rellena la clave del proveedor que uses.

# Proveedor de IA: "groq" (recomendado: gratis, muy rápido) u "openrouter".
LLM_PROVIDER=groq

# --- Groq (recomendado) --------------------------------------------------
# Crea una clave GRATIS en https://console.groq.com/keys
# Pégala aquí en UNA SOLA LÍNEA, sin comillas.
GROQ_API_KEY=
# Modelo(s) a probar, separados por coma (si uno se retira, usa el siguiente).
GROQ_MODEL=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- OpenRouter (alternativa) --------------------------------------------
# Clave gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# "auto" => elige solo un modelo gratuito disponible. O fija un slug concreto.
OPENROUTER_MODEL=auto

# Puerto del servidor local.
PORT=3000
